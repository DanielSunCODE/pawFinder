# Copia este archivo a backend/.env y ajusta los valores.
# El .env real NO se sube al repositorio.

# --- Entorno ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (MySQL local o Aiven) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pawfinder
DB_CONNECTION_LIMIT=10

# Aiven: DB_SSL_CA acepta la ruta a un archivo .pem O el PEM pegado entre
# comillas dobles. Si lo pegas SIN comillas, .env solo toma la primera linea.
# La CA es publica (no es secreto), pero el archivo .env no se versiona.
DB_SSL=false
DB_SSL_CA=
# DB_SSL_CA=./certs/aiven-ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
# MIIERDCCAqygAwIBAgIU...resto-del-certificado...
# -----END CERTIFICATE-----"


# --- Almacenamiento de imagenes: local | s3 ---
STORAGE_DRIVER=local

# Modo local: carpeta FUERA del proyecto y de cualquier carpeta de codigo.
RUTA_IMAGENES=D:\CODING\ITS\imagenes-pawFinder

# Tamano maximo por imagen (bytes). Por defecto 5 MB.
IMAGE_MAX_BYTES=5242880

# Compresion de las fotos subidas (se reescalan y reencoden antes de guardar).
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=80
IMAGE_OUTPUT_FORMAT=webp

# Modo s3 (solo si STORAGE_DRIVER=s3). Las credenciales van en el entorno
# del servicio (Render/AWS), nunca en el repositorio.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- URL publica del backend ---
PUBLIC_BASE_URL=http://localhost:3000
OPENAPI_SERVER_URL=http://localhost:3000
