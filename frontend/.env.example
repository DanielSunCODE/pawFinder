# Copia este archivo como .env.local y ajusta los valores.
# .env.local NO se sube al repositorio (está en .gitignore).

# URL base de la API vista desde el navegador.
# Déjala en /api: en desarrollo el proxy de Vite la reenvía a BACKEND_URL.
VITE_API_URL=/api

# true  = usa datos de prueba en memoria (no necesita backend).
# false = llama al backend real.
VITE_USAR_MOCKS=true

# A dónde reenvía el proxy de Vite las peticiones /api (sólo lo lee vite.config.ts).
BACKEND_URL=http://localhost:3000

# Centro inicial del mapa, "latitud,longitud", y nivel de zoom.
VITE_MAPA_CENTRO=19.4326,-99.1332
VITE_MAPA_ZOOM=13

# Opcional: otro proveedor de mapas. Si se dejan vacías se usa OpenStreetMap (sin llave).
# Si el proveedor pide llave, va dentro de la URL y NUNCA se sube al repositorio (.env.local está en .gitignore).
VITE_MAPA_MOSAICOS_URL=
VITE_MAPA_MOSAICOS_CREDITOS=
