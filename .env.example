# Variables del docker-compose.yml (docker compose up). Todas son opcionales: sin ellas se
# usan los valores por omisión, pensados sólo para correr en local. Copia este archivo a
# .env (no se versiona) para cambiarlos; en un servidor público usa contraseñas propias.

# MySQL del contenedor "bd"
DB_NAME=pawfinder
DB_USER=pawfinder
DB_PASSWORD=pawfinder
DB_ROOT_PASSWORD=pawfinder-root

# Origen permitido por CORS en el backend (el proxy local escucha en el 8080)
CORS_ORIGIN=http://localhost:8080

# Cargar catálogos y perritos de prueba la primera vez (base vacía). false = no sembrar
SEED_AL_ARRANCAR=true
