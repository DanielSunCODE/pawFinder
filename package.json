{
  "name": "pawfinder",
  "version": "0.1.0",
  "private": true,
  "description": "Registro de perritos de la calle - proyecto de Programacion logica y funcional",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend",
    "database"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace @pawfinder/backend",
    "dev:frontend": "npm run dev --workspace @pawfinder/frontend",
    "build:backend": "npm run build --workspace @pawfinder/backend",
    "test:backend": "npm run test --workspace @pawfinder/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:migrate": "tsx database/scripts/migrate.ts",
    "db:seed": "tsx database/scripts/seed.ts",
    "db:reset": "tsx database/scripts/reset-local.ts",
    "db:backup": "bash database/scripts/backup.sh",
    "db:restore": "bash database/scripts/restore.sh",
    "db:typecheck": "tsc -p database/tsconfig.json"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
