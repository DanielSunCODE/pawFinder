# Entorno
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos (MySQL local o Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pawfinder
DB_PASSWORD=cambia_esta_clave
DB_NAME=pawfinder
DB_SSL=false
DB_SSL_CA=

# Almacenamiento de imagenes: local | s3
STORAGE_DRIVER=local
RUTA_IMAGENES=C:/Users/tu_usuario/pawfinder-imagenes
IMAGE_MAX_BYTES=5242880

# Solo si STORAGE_DRIVER=s3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL publica del backend (para construir enlaces a las fotos)
PUBLIC_BASE_URL=http://localhost:3000

# URL que Swagger UI muestra como servidor del API (opcional; por defecto http://localhost:PORT)
OPENAPI_SERVER_URL=http://localhost:3000
