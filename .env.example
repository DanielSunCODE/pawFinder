# Variables del docker-compose.yml (docker compose up). Todas son opcionales: sin ellas se
# usan los valores por omisión, pensados sólo para correr en local. Copia este archivo a
# .env (no se versiona) para cambiarlos; en un servidor público usa contraseñas propias.

# MySQL del contenedor "bd"
DB_NAME=pawfinder
DB_USER=pawfinder
DB_PASSWORD=pawfinder
DB_ROOT_PASSWORD=pawfinder-root

# Origen permitido por CORS en el backend (el proxy local escucha en el 8080)
CORS_ORIGIN=http://localhost:8080

# Cargar catálogos y perritos de prueba la primera vez (base vacía). false = no sembrar
SEED_AL_ARRANCAR=true

# ── Servicio Elixir (Proyecto 2, contenedor "funcional") ──
# El docker-compose.yml ya fija estos valores; se listan como referencia (comentados, para no
# pisar nada). Para correr el servicio sin Docker (cd funcional && mix run --no-halt) expórtalos
# en tu terminal.
#   PORT=4000                           puerto del servicio
#   BACKEND_URL=http://localhost:3000   backend del P1 al que le pide GET /api/perritos
#                                       (en Docker: http://backend:3000)
#   TZ=America/Monterrey                zona horaria del contenedor (por omisión sería UTC); las
#                                       estadísticas por día no dependen de esto: el núcleo recibe
#                                       el desfase de Saltillo (UTC-6) como argumento
#   CORS_ORIGIN=https://mi-front.app    orígenes que pueden llamar al servicio desde el navegador;
#                                       sólo si el frontend está en otro origen (p. ej. Vercel).
#                                       Es el mismo nombre que usa el backend (ver arriba).
