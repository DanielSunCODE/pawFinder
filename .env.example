# --- Base de datos ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=perritos_db
DB_SSL=false
DB_SSL_CA=
DB_CONNECTION_LIMIT=10

# Para conectar a Aiven, descarga "CA certificate" desde el dashboard de
# Aiven (Overview > CA certificate > Download) y guárdalo en el repo
# fuera del control de versiones (o en secrets del CI), luego:
# DB_HOST=xxxx-xxxx-xxxx.aivencloud.com
# DB_PORT=xxxxx
# DB_USER=avnadmin
# DB_PASSWORD=xxxxxxxxxxxx
# DB_NAME=defaultdb
# DB_SSL=true
# DB_SSL_CA=./certs/aiven-ca.pem

# --- Storage de imágenes ---
STORAGE_DRIVER=local

# Driver local: carpeta FUERA del repo donde se guardan las fotos.
RUTA_IMAGENES=/ruta/absoluta/fuera/del/repo/perritos-uploads

# Driver s3 (si STORAGE_DRIVER=s3):
# S3_BUCKET=perritos-fotos-prod
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
